generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SALES
  CONTENT_MANAGER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum PreferredContactMethod {
  EMAIL
  PHONE
  WHATSAPP
}

enum InquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
  CANCELLED
  SPAM
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  CONTACTED
  INSPECTION_SCHEDULED
  INSPECTED
  OFFER_MADE
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum VehicleStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  ARCHIVED
}

enum VehicleImageCategory {
  EXTERIOR
  INTERIOR
  DETAIL
  DOCUMENT
  OTHER
}

enum FeatureCategory {
  SAFETY
  COMFORT
  INFOTAINMENT
  EXTERIOR
  INTERIOR
  PERFORMANCE
  CONVENIENCE
}

enum TestDriveStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULE_REQUESTED
  RESCHEDULED
  COMPLETED
  CANCELLED
  REJECTED
  NO_SHOW
}

model User {
  id                      String                        @id @default(cuid())
  name                    String?
  email                   String                        @unique
  emailVerified           DateTime?
  image                   String?
  phone                   String?                       @unique
  city                    String?
  passwordHash            String?
  role                    UserRole                      @default(CUSTOMER)
  status                  UserStatus                    @default(PENDING_VERIFICATION)
  preferredContactMethod  PreferredContactMethod        @default(EMAIL)
  sessionVersion          Int                           @default(1)
  lastLoginAt             DateTime?
  deletedAt               DateTime?
  accounts                Account[]
  sessions                Session[]
  favorites               Favorite[]
  inquiries               Inquiry[]                     @relation("CustomerInquiries")
  assignedInquiries       Inquiry[]                     @relation("AssignedInquiries")
  testDrives              TestDrive[]                   @relation("CustomerTestDrives")
  assignedTestDrives      TestDrive[]                   @relation("AssignedTestDrives")
  sellRequests            SellRequest[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  notificationSettings    CustomerNotificationSettings?
  engagementMessages      CustomerEngagementMessage[]
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model CustomerNotificationSettings {
  id                   String    @id @default(cuid())
  userId               String    @unique
  enquiryUpdates       Boolean   @default(true)
  testDriveReminders   Boolean   @default(true)
  priceChangeAlerts    Boolean   @default(true)
  soldVehicleAlerts    Boolean   @default(true)
  marketingEmails      Boolean   @default(false)
  whatsAppUpdates      Boolean   @default(false)
  marketingConsentedAt DateTime?
  whatsAppConsentedAt  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Brand {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  logoUrl      String
  logoAlt      String
  description  String
  websiteUrl   String?
  country      String
  featured     Boolean   @default(false)
  active       Boolean   @default(true)
  displayOrder Int       @default(0)
  vehicles     Vehicle[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([active])
  @@index([featured])
  @@index([displayOrder])
}

model BodyType {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  description  String
  icon         String?
  imageUrl     String?
  featured     Boolean   @default(false)
  active       Boolean   @default(true)
  displayOrder Int       @default(0)
  vehicles     Vehicle[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([active])
  @@index([featured])
  @@index([displayOrder])
}

model Vehicle {
  id                       String           @id @default(cuid())
  slug                     String           @unique
  stockNumber              String           @unique
  brandId                  String
  brand                    Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  bodyTypeId               String
  bodyType                 BodyType         @relation(fields: [bodyTypeId], references: [id], onDelete: Restrict)
  model                    String
  variant                  String
  shortTitle               String
  year                     Int
  registrationYear         Int?
  registrationState        String?
  /// Indian Rupees stored as an integer; formatting is handled by the application.
  price                    Int
  originalPrice            Int?
  mileage                  Int
  fuelType                 String
  transmission             String
  exteriorColor            String?
  interiorColor            String?
  ownershipCount           Int?
  engineDisplacement       Int?
  engineDescription        String?
  power                    String?
  torque                   String?
  drivetrain               String?
  seatingCapacity          Int?
  doors                    Int?
  registrationNumberMasked String?
  insuranceValidity        DateTime?
  serviceHistory           String?
  keysAvailable            Int?
  shortDescription         String
  description              String
  status                   VehicleStatus    @default(DRAFT)
  featured                 Boolean          @default(false)
  newArrival               Boolean          @default(false)
  certified                Boolean          @default(false)
  published                Boolean          @default(false)
  viewCount                Int              @default(0)
  favoriteCount            Int              @default(0)
  publishedAt              DateTime?
  images                   VehicleImage[]
  features                 VehicleFeature[]
  favorites                Favorite[]
  inquiries                Inquiry[]
  testDrives               TestDrive[]
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@index([brandId])
  @@index([bodyTypeId])
  @@index([model])
  @@index([year])
  @@index([price])
  @@index([mileage])
  @@index([fuelType])
  @@index([transmission])
  @@index([status])
  @@index([featured])
  @@index([newArrival])
  @@index([certified])
  @@index([published])
  @@index([createdAt])
  @@index([publishedAt])
  @@index([published, status])
  @@index([brandId, published, status])
  @@index([bodyTypeId, published, status])
  @@index([featured, published])
  @@index([newArrival, published])
}

model VehicleImage {
  id           String               @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url          String
  thumbnailUrl String?
  altText      String
  category     VehicleImageCategory @default(EXTERIOR)
  sortOrder    Int                  @default(0)
  width        Int?
  height       Int?
  blurDataUrl  String?
  isPrimary    Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([vehicleId])
  @@index([vehicleId, sortOrder])
  @@index([vehicleId, isPrimary])
}

model Feature {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  category    FeatureCategory
  icon        String?
  description String?
  active      Boolean          @default(true)
  vehicles    VehicleFeature[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([category])
  @@index([active])
}

model VehicleFeature {
  vehicleId String
  featureId String
  value     String?
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([vehicleId, featureId])
  @@index([featureId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  vehicleId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, vehicleId])
  @@index([vehicleId])
}

model Inquiry {
  id                     String                      @id @default(cuid())
  referenceNumber        String                      @unique
  userId                 String?
  vehicleId              String?
  fullName               String                      @map("name")
  phone                  String
  email                  String
  message                String
  consentAccepted        Boolean                     @default(false) @map("consent")
  preferredContactMethod PreferredContactMethod      @default(EMAIL)
  status                 InquiryStatus               @default(NEW)
  assignedToId           String?
  submittedAt            DateTime                    @default(now())
  user                   User?                       @relation("CustomerInquiries", fields: [userId], references: [id], onDelete: SetNull)
  assignedTo             User?                       @relation("AssignedInquiries", fields: [assignedToId], references: [id], onDelete: SetNull)
  vehicle                Vehicle?                    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  messages               CustomerEngagementMessage[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@index([userId])
  @@index([vehicleId])
  @@index([status])
  @@index([assignedToId])
  @@index([submittedAt])
}

model TestDrive {
  id                     String                      @id @default(cuid())
  referenceNumber        String                      @unique
  userId                 String?
  vehicleId              String
  fullName               String                      @map("name")
  phone                  String
  email                  String
  preferredDate          DateTime
  preferredTime          String
  confirmedDate          DateTime?
  confirmedTime          String?
  message                String?
  cancellationReason     String?
  consentAccepted        Boolean                     @default(false) @map("consent")
  preferredContactMethod PreferredContactMethod      @default(EMAIL)
  status                 TestDriveStatus             @default(REQUESTED)
  assignedToId           String?
  submittedAt            DateTime                    @default(now())
  user                   User?                       @relation("CustomerTestDrives", fields: [userId], references: [id], onDelete: SetNull)
  assignedTo             User?                       @relation("AssignedTestDrives", fields: [assignedToId], references: [id], onDelete: SetNull)
  vehicle                Vehicle                     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  messages               CustomerEngagementMessage[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@index([userId])
  @@index([vehicleId])
  @@index([status])
  @@index([assignedToId])
  @@index([preferredDate])
  @@index([submittedAt])
}

model SellRequest {
  id              String        @id @default(cuid())
  referenceNumber String        @unique
  userId          String?
  status          RequestStatus @default(DRAFT)
  name            String?
  email           String?
  phone           String?
  make            String?
  model           String?
  year            Int?
  mileage         Int?
  fuelType        String?
  transmission    String?
  city            String?
  message         String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model CustomerEngagementMessage {
  id              String     @id @default(cuid())
  userId          String
  inquiryId       String?
  testDriveId     String?
  body            String
  sentByCustomer  Boolean    @default(true)
  customerVisible Boolean    @default(true)
  createdAt       DateTime   @default(now())
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  inquiry         Inquiry?   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  testDrive       TestDrive? @relation(fields: [testDriveId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([inquiryId, createdAt])
  @@index([testDriveId, createdAt])
}

model ReferenceCounter {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model NewsletterSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  active      Boolean  @default(true)
  consentedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  quote     String
  avatarUrl String?
  purchase  String?
  location  String?
  featured  Boolean  @default(false)
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  alt       String
  href      String?
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

model Showroom {
  id         String   @id @default(cuid())
  name       String
  address    String
  city       String
  state      String
  postalCode String
  phone      String
  email      String
  hours      String
  mapUrl     String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContentBlock {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}
