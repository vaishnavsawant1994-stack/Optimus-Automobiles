    "@next-auth/prisma-adapter": "^1.0.7",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "next-auth": "^4.24.15",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "server-only": "^0.0.1",
